# Live-verified 2026-10-04, with a caveat: `ALARM_AUTO_DISMISS_MS` (~2s)
# fires so quickly after the ring screen appears that this CLI's own
# install/screenshot round-trip latency couldn't reliably catch a
# screenshot of the ring screen still showing before it auto-stopped - even
# with no extra SLEEP at all, the auto-dismiss had already completed by the
# time `pebble screenshot` connected. This sequence only asserts the
# externally-observable END state (back on the main list, alarm in its
# normal enabled tint, not stuck ringing and not disabled) rather than a
# mid-ring screenshot - which is still a meaningful regression check (a
# bug that made the alarm hang on the ring screen, or leave it disabled
# instead of re-enabled, would show up here).
#
# Keys: TestAlarmIndex=10009, TestAlarmHour=10010, TestAlarmMinute=10011,
# TestAlarmEnabled=10014, TestAlarmAutoDismiss=10029, TestAlarmPending=10023,
# TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10009=0 10010=7 10011=0 10014=1 10029=1 10023=1 --string 10020=Wakeup
SLEEP 1
KILL
INSTALL
SLEEP 3
SCREENSHOT main_list_auto_dismissed_still_enabled --mask-rect 70x25+0+203
