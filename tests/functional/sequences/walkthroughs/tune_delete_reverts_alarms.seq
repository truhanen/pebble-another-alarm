# Live-verified end-to-end 2026-10-04 (re-verified after a golden-image
# review caught a wrong preselect assumption in an earlier version - see
# below). Deleting a tune referenced by two alarms (via the Custom-tune
# screen's Delete row -> confirm) pops only ONE window back to the Tune
# picker (not all the way to Signal, unlike Apply), resets the picker's
# own selection to row 0 ("Off") since the deleted row vanished, and
# reverts BOTH alarms' `sound_pattern_kind` to Preset (shown as "Triple",
# the default preset - `sound_enabled` itself is left untouched/still on).
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020, TestAlarmTuneId=10044,
# TestClearTunes=10040, TestTuneIndex=10041, TestTuneName=10042,
# TestTuneCustomPattern=10043
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Wakeup
SLEEP 1
APPMSG --int 10040=1 10041=0 --string 10042=Bells "10043=C z E z G"
SLEEP 1
APPMSG --int 10009=0 10044=1
SLEEP 1
APPMSG --int 10009=1 10010=8 10011=0 10044=1 --string 10020=Backup
SLEEP 1

# Wakeup (row 1 on the main list) first.
TAP down
LONGPRESS select
SLEEP 1
TAP down
TAP down
TAP down
TAP down
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
TAP down
SLEEP 1
TAP select
SLEEP 1
# Wakeup is ALREADY linked to Bells (sound_pattern_kind=2), so the picker
# preselects directly on the "Bells" row - no further navigation needed.
# An earlier version of this file wrongly assumed it opened on "Triple"
# (as a never-touched alarm would) and added 7 more downs here, which
# overshot into "Custom tune help" instead - confirmed the hard way via a
# golden-image review.
SCREENSHOT tune_picker_bells_selected
TAP select
SLEEP 1
TAP down
TAP down
TAP down
SLEEP 1
SCREENSHOT custom_tune_screen_delete_selected
TAP select
SLEEP 1
SCREENSHOT confirm_delete_cancel_prompt
TAP select
SLEEP 1
SCREENSHOT tune_picker_off_selected_bells_gone

# Pops back to Signal - this is still WAKEUP's own Signal menu (the alarm
# whose edit menu we're inside), not Backup's.
TAP back
SLEEP 1
SCREENSHOT wakeup_signal_reverted_to_triple --mask-rect 70x25+0+203

# Back out to the main list (Signal -> edit menu -> main list, 2 backs),
# then move DOWN to Backup (row 2, below Wakeup) - an earlier version of
# this file pressed TAP up here instead, which is backwards (Backup sorts
# after Wakeup, not before it).
TAP back
SLEEP 1
TAP back
SLEEP 1
TAP down
SLEEP 1
LONGPRESS select
SLEEP 1
TAP down
TAP down
TAP down
TAP down
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT backup_signal_also_reverted_to_triple --mask-rect 70x25+0+203
