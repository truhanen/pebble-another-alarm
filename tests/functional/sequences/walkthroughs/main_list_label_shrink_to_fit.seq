# Not yet live-verified. ml_pick_label_font() drops from GOTHIC_24_BOLD to
# GOTHIC_18_BOLD when the label doesn't fit next to the bold time text -
# compare a short label (normal size) against a long one (shrunk, nudged
# down 6px per main.c's own hand-tuned offset).
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq

APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Gym
SLEEP 1
TAP down
SLEEP 1
SCREENSHOT short_label_normal_size --mask-rect 70x25+0+203

APPMSG --int 10009=1 10010=8 10011=0 --string 10020=WeekendLongLabelName
SLEEP 1
TAP down
SLEEP 1
SCREENSHOT long_label_shrunk --mask-rect 70x25+0+203
