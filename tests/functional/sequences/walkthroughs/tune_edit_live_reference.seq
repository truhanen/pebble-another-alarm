# Live-verified end-to-end 2026-10-04.
#
# IMPORTANT, live-verified: a saved tune's id allocation starts at 1, not
# 0 (`store_alloc_tune_id()`, alarm_store.c: `persist_exists(...) ? ... :
# 1`) - `TestAlarmTuneId=0` silently links to a nonexistent tune
# (find_tune_by_id returns NULL, Signal's Tune row falls back to showing
# "Custom" generically instead of the tune's real name). The first tune
# created after a fresh wipe always gets id 1.
#
# Also confirmed: renaming a tune from its own "Custom tune" screen (via
# the TestTuneName hook here, standing in for typing through the keyboard)
# is reflected on the Tune PICKER as soon as you back out of the Custom
# tune screen - but the Signal submenu of an alarm that's ALREADY open
# does not refresh live; back out to the main list and reopen (same
# reload_ui() limitation documented in common/wipe_and_prep.seq).
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020, TestAlarmTuneId=10044,
# TestClearTunes=10040, TestTuneIndex=10041, TestTuneName=10042,
# TestTuneCustomPattern=10043
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Wakeup
SLEEP 1
APPMSG --int 10040=1 10041=0 --string 10042=Chime "10043=C z E z G"
SLEEP 1
APPMSG --int 10009=0 10044=1
SLEEP 1
APPMSG --int 10009=1 10010=8 10011=0 10044=1 --string 10020=Backup
SLEEP 1

TAP down
LONGPRESS select
SLEEP 1
TAP down
TAP down
TAP down
TAP down
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT wakeup_signal_tune_chime --mask-rect 70x25+0+203

TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT tune_picker_chime_preselected
TAP select
SLEEP 1
SCREENSHOT custom_tune_screen_chime

# Rename via the test hook, then back out to the picker to see it refresh.
APPMSG --int 10041=0 --string 10042=Bells
SLEEP 1
TAP back
SLEEP 1
SCREENSHOT tune_picker_renamed_to_bells

# Back out to the main list entirely, then check the OTHER alarm
# (Backup, also linked to this tune id) reflects the rename too.
TAP back
SLEEP 1
TAP back
SLEEP 1
TAP back
SLEEP 1
TAP down
LONGPRESS select
SLEEP 1
TAP down
TAP down
TAP down
TAP down
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT backup_signal_also_shows_bells --mask-rect 70x25+0+203
