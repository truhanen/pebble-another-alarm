# Live-verified end-to-end 2026-10-04. Tune picker row 0 is "Off"; row 1
# ("Triple") shows a right-aligned "default" marker since it's the phone-
# configured default sound pattern; selecting a different preset ("Double")
# commits immediately - no keyboard step at all - straight back to Signal.
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Wakeup
SLEEP 1

TAP down
LONGPRESS select
SLEEP 1
# Edit menu row order (non-cron): Delete(0) Time(1) Label(2) State(3)
# Repeat(4) Snooze(5) Signal(6) - 6 downs from the default Delete selection.
TAP down
TAP down
TAP down
TAP down
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT tune_picker_triple_default_marker

TAP select
SLEEP 1
SCREENSHOT signal_menu_tune_triple --mask-rect 70x25+0+203

TAP select
SLEEP 1
TAP down
SLEEP 1
SCREENSHOT tune_picker_double_highlighted
TAP select
SLEEP 1
SCREENSHOT signal_menu_tune_double --mask-rect 70x25+0+203
