# Live-verified end-to-end 2026-10-04. Snooze is a plain SINGLE click on
# UP (unlike Stop's double-click on DOWN - see ring_trigger_and_stop.seq's
# own header note on why Stop needs the CMD escape hatch while this one
# doesn't). After snoozing, the main list shows the alarm in its red
# "snoozing" tint and the bottom bar's "Next:" reflects the snooze
# deadline.
#
# Keys: TestAlarmIndex=10009, TestAlarmHour=10010, TestAlarmMinute=10011,
# TestAlarmEnabled=10014, TestAlarmPending=10023, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10009=0 10010=7 10011=0 10014=1 10023=1 --string 10020=Wakeup
SLEEP 1
KILL
INSTALL
SLEEP 3
SCREENSHOT ring_screen_showing --mask-rect 70x30+0+198

TAP up
SLEEP 1
SCREENSHOT main_list_snoozing_red_tint --mask-rect 70x25+0+203
