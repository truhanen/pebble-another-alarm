# Live-verified end-to-end 2026-10-04 for the mechanical path: the Label
# row opens the multitap keyboard pre-filled with the alarm's current name,
# and submitting it unchanged (TAP select - multitap_keyboard_submit) keeps
# the label the same. Actually typing a NEW name needs TOUCH (see
# keyboard_label_touch_entry.seq's header note on this device's touch-only
# typing model) - this sequence uses the TestAlarmName hook afterward to
# simulate a completed rename and confirms the edit menu reflects it on
# reopen (reload_ui() doesn't refresh an already-open edit menu - see
# common/wipe_and_prep.seq's own note - so this backs out to the main list
# first).
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Wakeup
SLEEP 1

TAP down
LONGPRESS select
SLEEP 1
TAP down
TAP down
SLEEP 1
TAP select
SLEEP 1
# The keyboard's text cursor blinks until the keyboard has been idle ~5s, then stops:
# wait that out so the screenshot never lands on a different blink phase.
SLEEP 5
SCREENSHOT label_keyboard_prefilled_wakeup
TAP select
SLEEP 1
SCREENSHOT edit_menu_label_unchanged --mask-rect 70x25+0+203

# Submitting the keyboard already popped it back to the edit menu (depth 1
# from main list) - one more BACK reaches the main list. A SECOND back here
# would exit the app entirely (BACK on the main list's root window pops to
# the watchface/launcher) - confirmed the hard way while authoring this.
TAP back
SLEEP 1
APPMSG --int 10009=0 --string 10020=Gym
SLEEP 1
LONGPRESS select
SLEEP 1
SCREENSHOT edit_menu_label_renamed_to_gym --mask-rect 70x25+0+203
