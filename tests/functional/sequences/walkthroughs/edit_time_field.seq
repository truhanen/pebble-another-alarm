# Live-verified end-to-end 2026-10-04. Opens an existing alarm's Time
# editor from the edit menu, confirms a normal Apply, then separately
# confirms that BACK on the hour field (field 0) discards the in-progress
# edit and reverts to the alarm's original time (edit_on_time_confirm has
# no on_cancel, so BACK falls back to the snapshot-revert convention - see
# CLAUDE.md's time/snooze editor design point).
#
# Keys: TestClearAlarms=10008, TestAlarmIndex=10009, TestAlarmHour=10010,
# TestAlarmMinute=10011, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10008=1 10009=0 10010=7 10011=0 --string 10020=Wakeup
SLEEP 1

TAP down
LONGPRESS select
SLEEP 1
SCREENSHOT edit_menu_delete_selected --mask-rect 70x25+0+203
TAP down
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT time_editor_07_00 --mask-rect 70x25+0+203

# Bump the hour, then BACK out on the hour field - should revert to 07:00.
TAP up
SLEEP 1
SCREENSHOT time_editor_bumped_to_08 --mask-rect 70x25+0+203
TAP back
SLEEP 1
SCREENSHOT edit_menu_time_reverted_to_07_00 --mask-rect 70x25+0+203

# Now a real Apply: hour field -> minute field -> confirm at 08:00.
TAP select
SLEEP 1
TAP up
SLEEP 1
TAP select
SLEEP 1
TAP select
SLEEP 1
SCREENSHOT edit_menu_time_applied_08_00 --mask-rect 70x25+0+203
