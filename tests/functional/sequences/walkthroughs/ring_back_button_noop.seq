# Live-verified end-to-end 2026-10-04. BACK on the ring screen does
# nothing - it's explicitly subscribed to a no-op handler so Pebble's
# default "pop the window" behavior can't silently dismiss an alarm
# (CLAUDE.md's own design point on this).
#
# Keys: TestAlarmIndex=10009, TestAlarmHour=10010, TestAlarmMinute=10011,
# TestAlarmEnabled=10014, TestAlarmPending=10023, TestAlarmName=10020
IMPORT ../common/wipe_and_prep.seq
APPMSG --int 10009=0 10010=7 10011=0 10014=1 10023=1 --string 10020=Wakeup
SLEEP 1
KILL
INSTALL
SLEEP 3
SCREENSHOT ring_screen_before_back --mask-rect 70x30+0+198
TAP back
SLEEP 1
SCREENSHOT ring_screen_unaffected_after_back --mask-rect 70x30+0+198
