{
  "name": "pebble-another-alarm",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Another alarm",
    "uuid": "e3abb208-0d25-43eb-b6b5-c9d8abde0159",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "FirstDayOfWeek",
      "AlarmVibePattern",
      "DefaultSnoozeMinutes",
      "DefaultSnoozeMax",
      "AudioVolume",
      "DefaultAlarmSignal[2]",
      "TestClearAlarms",
      "TestAlarmIndex",
      "TestAlarmHour",
      "TestAlarmMinute",
      "TestAlarmRepeats",
      "TestAlarmRepeatDays",
      "TestAlarmEnabled",
      "TestAlarmSnoozeMinutes",
      "TestAlarmSnoozeMax",
      "TestAlarmVibrationEnabled",
      "TestAlarmSoundEnabled",
      "TestAlarmName",
      "TestAlarmSnoozeInSec",
      "TestAlarmLastFiredToday",
      "TestAlarmPending"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_OFF",
          "file": "images/shift-off.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_ONCE",
          "file": "images/shift-once.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_SHIFT_LOCK",
          "file": "images/shift-lock.png"
        }
      ]
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "node --test tests/*.test.js"
  }
}
